PORT=4005
DEPLOYMENT_PROFILE=public
LAWFUL_ACCESS_ENABLED=true
ACCESS_AUDIT_URL=http://localhost:4004
INTERNAL_SERVICE_SECRET=change-me-internal
# Dev: shared secret when mTLS is off (production: LAWFUL_MTLS_REQUIRED=true behind TLS terminator)
LAWFUL_MTLS_REQUIRED=false
LAWFUL_API_SHARED_SECRET=change-me-lawful-api
# Comma-separated IPs or CIDRs; empty = allow all
LAWFUL_IP_ALLOWLIST=
CORPORATE_CONNECTIVITY_MODE=isolated
