generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Append-only privileged access audit log (lawful + internal admin).
model PrivilegedAuditEvent {
  id                    String   @id @default(uuid()) @db.Uuid
  deploymentProfile     String   @map("deployment_profile")
  action                String
  scopeJson             Json     @map("scope_json")
  reasonCode            String   @map("reason_code")
  reasonText            String   @map("reason_text")
  legalRef              String   @unique @map("legal_ref")
  disclosureLevel       String   @map("disclosure_level")
  userFacingSummary     String?  @map("user_facing_summary")
  actor                 String
  privilegedOperationId String   @map("privileged_operation_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@map("privileged_audit_events")
}

model Complaint {
  id              String   @id @default(uuid()) @db.Uuid
  eventId         String   @map("event_id")
  userId          String   @map("user_id") @db.Uuid
  body            String
  status          String   @default("pending")
  outcomeSummary  String?  @map("outcome_summary")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([eventId, userId])
  @@index([status, createdAt(sort: Desc)])
  @@map("complaints")
}
