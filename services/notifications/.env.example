PORT=4003
JWT_SECRET=change-me-to-a-long-random-secret
INTERNAL_SERVICE_SECRET=change-me-internal
DATABASE_URL=postgresql://message2:message2@localhost:15432/message2
PUSH_STORE=postgres
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost
# FCM legacy HTTP API (Android); optional until apps/android registers tokens
FCM_ENABLED=false
FCM_LEGACY_SERVER_KEY=
# Log-only delivery when no provider keys (default in dev)
PUSH_DRY_RUN=true
