generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String           @id @default(uuid()) @db.Uuid
  displayName    String
  username       String           @unique
  avatarUrl      String?
  passwordHash   String
  role           UserRole         @default(user)
  createdAt      DateTime         @default(now())
  chats          ChatMember[]
  sentMessages   Message[]        @relation("SenderMessages")
  refreshSession RefreshSession[]
  privateProfile UserPrivateProfile?
  transparencyNotices TransparencyUserNotice[]
}

model Chat {
  id        String       @id @default(uuid()) @db.Uuid
  title     String
  createdAt DateTime     @default(now())
  members   ChatMember[]
  messages  Message[]
  disclosures MessageDisclosure[]
  tombstones MessageTombstone[]
}

model ChatMember {
  chatId    String   @db.Uuid
  userId    String   @db.Uuid
  joinedAt  DateTime @default(now())
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@index([userId, chatId])
}

model Message {
  id         String    @id @default(uuid()) @db.Uuid
  chatId     String    @db.Uuid
  senderId   String    @db.Uuid
  cipherText String
  sentAt     DateTime  @default(now())
  kind       String    @default("text")
  mediaId    String?   @db.Uuid
  chat       Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender     User      @relation("SenderMessages", fields: [senderId], references: [id], onDelete: Cascade)
  disclosures MessageDisclosure[]

  @@index([chatId, sentAt(sort: Desc)])
}

model MessageDisclosure {
  id              String   @id @default(uuid()) @db.Uuid
  messageId       String   @db.Uuid
  chatId          String   @db.Uuid
  eventId         String
  action          String
  disclosureLevel String
  createdAt       DateTime @default(now())
  message         Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  chat            Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([messageId, eventId])
  @@index([chatId])
}

model MessageTombstone {
  id        String    @id @default(uuid()) @db.Uuid
  messageId String    @db.Uuid
  chatId    String    @db.Uuid
  eventId   String
  senderId  String?   @db.Uuid
  kind      String?
  sentAt    DateTime?
  label     String
  deletedAt DateTime  @default(now())
  chat      Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([messageId, eventId])
  @@index([chatId])
}

model TransparencyUserNotice {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  eventId         String
  action          String
  scopeJson       String
  disclosureLevel String
  summary         String?
  createdAt       DateTime  @default(now())
  readAt          DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model RefreshSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  revokedReason String?
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model UserPrivateProfile {
  userId         String   @id @db.Uuid
  emailEnc       Bytes?
  phoneEnc       Bytes?
  dekWrapped     Bytes
  keyVersion     Int
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserRole {
  user
  admin
}
