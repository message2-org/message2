# Host port mapped to Postgres in the container (container still listens on 5432).
# If bind fails ("port is already allocated"), pick a free port and use the same
# value in services/messaging/.env → DATABASE_URL (host port only).
MESSAGE2_POSTGRES_PORT=15432
MESSAGE2_JWT_SECRET=change-me-in-production
MESSAGE2_DATA_ENCRYPTION_MASTER_KEY=change-me-in-production
MESSAGE2_ONBOARDING_BOT_USERNAME=message2_bot
MESSAGE2_ONBOARDING_BOT_DISPLAY_NAME=Послание 2
MESSAGE2_ONBOARDING_WELCOME_CHAT_TITLE=Послание2
MESSAGE2_ONBOARDING_WELCOME_CHAT_TITLE_RU=Послание2
MESSAGE2_ONBOARDING_WELCOME_CHAT_TITLE_EN=Message2
MESSAGE2_ONBOARDING_SAVED_CHAT_TITLE=Сохранённое
MESSAGE2_ONBOARDING_SAVED_CHAT_TITLE_RU=Сохранённое
MESSAGE2_ONBOARDING_SAVED_CHAT_TITLE_EN=Saved
MESSAGE2_ONBOARDING_WELCOME_TEXT=Добро пожаловать в Послание2! Здесь можно быстро начать общение и проверить, что всё работает.
MESSAGE2_ONBOARDING_WELCOME_TEXT_RU=Добро пожаловать в Послание2! Здесь можно быстро начать общение и проверить, что всё работает.
